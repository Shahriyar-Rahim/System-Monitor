{
  "name": "system_monitor",
  "version": "1.0.0",
  "description": "Live CPU, memory, storage and network monitor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder -lw"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shahriyar-Rahim/System-Monitor.git"
  },
  "keywords": [],
  "author": "Md. Shahriyar Rahim <mdshahriyarrahim@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Shahriyar-Rahim/System-Monitor/issues"
  },
  "homepage": "https://github.com/Shahriyar-Rahim/System-Monitor#readme",
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.systemmonitor.app",
    "productName": "System Monitor",
    "executableName": "system-monitor",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Md. Shahriyar Rahim <mdshahriyarrahim@gmail.com>"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
